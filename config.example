# TrackLin.es TUI config: copy to ~/.config/tracklines/config and change what you like.
#   mkdir -p ~/.config/tracklines && cp config.example ~/.config/tracklines/config
# One "name = value" per line; # starts a comment. Anything left out keeps its default.

# How writing a ticket or comment works:
#   vim       modes: typing is insert mode, esc is normal mode; :w / :wq save, :q leaves
#             (refused over unsaved text), :q! discards
#   standard  no modes: ctrl+s saves, esc cancels (twice over unsaved text)
# ctrl+s saves with either.
keys = vim

# The order a backlog opens in (s still cycles through them):
#   manual  the backlog's own order
#   newest  newest first
#   oldest  oldest first
backlog_sort = manual

# Send the TUI's own failures (the API failing or unreachable, a crash) to Bugfixes so they get fixed.
# Reports never include your API key, what you searched for, or what you wrote. on | off
reports = on

# Look for a newer release when it starts (release builds only); ? then u installs it. on | off
update_check = on

# The language the TUI speaks (tickets and comments stay as written):
#   system  your locale (LANG, LC_ALL, LC_MESSAGES) when it's one the TUI has, else English
#   en      English
#   nl      Nederlands
#   de      Deutsch
#   es      Español
#   pt      Português (Brasil)
#   fr      Français
language = system
